# Copier en `.env.production` avant `npm run build` si le front est sur lawapp50.com
# et l’API sur backend.lawapp50.com (sans proxy nginx sur le même domaine).

VITE_USE_API=true
VITE_API_BASE=https://backend.lawapp50.com/api
VITE_AUTH_BASE=https://backend.lawapp50.com

# Le backend doit autoriser CORS pour https://lawapp50.com (Origin + credentials si JWT cookie).
