# Copier en `.env.production` avant `npm run build` si le front est sur lawapp50.com
# et l’API sur backend.lawapp50.com (sans proxy nginx sur le même domaine).

VITE_USE_API=true
VITE_API_BASE=https://backend.lawapp50.com/api
VITE_AUTH_BASE=https://backend.lawapp50.com

# CORS backend : autoriser UNIQUEMENT https://lawapp50.com (sans www).
# www.lawapp50.com est redirigé vers l’apex (index.html + public/_redirects + vercel.json).
# Si vous devez garder www, ajoutez https://www.lawapp50.com dans la config CORS Spring.
